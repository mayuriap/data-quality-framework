{
  "expectation_suite_name": "gold_daily_suite",
  "expectations": [
    {
      "expectation_type": "expect_table_row_count_to_be_between",
      "kwargs": {
        "min_value": 1,
        "max_value": {
          "$PARAMETER": "silver_transaction_count"
        }
      },
      "meta": {
        "notes": "Gold daily summary must have fewer rows than Silver — grouped by date and currency"
      }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "transaction_date"
      },
      "meta": {
        "notes": "transaction_date must never be null in Gold"
      }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "currency"
      },
      "meta": {
        "notes": "currency must never be null in Gold"
      }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "total_amount"
      },
      "meta": {
        "notes": "total_amount must never be null in Gold"
      }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "total_transactions"
      },
      "meta": {
        "notes": "total_transactions must never be null in Gold"
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_in_set",
      "kwargs": {
        "column": "currency",
        "value_set": ["GBP", "USD", "EUR", "JPY", "CHF"]
      },
      "meta": {
        "notes": "Only valid currencies in Gold daily summary"
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "total_amount",
        "min_value": 0.01
      },
      "meta": {
        "notes": "Total amount must always be positive in Gold"
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "total_transactions",
        "min_value": 1
      },
      "meta": {
        "notes": "Must have at least 1 transaction per row in Gold"
      }
    }
  ],
  "meta": {
    "great_expectations_version": "1.4.1",
    "description": "Gold daily summary expectations. Validates aggregated data correctness and completeness."
  }
}